{
  "allowed_exclusions": [
    "source assembly without qualified implementation",
    "physical device observations or post-layout GPU operations",
    "external behavior without a supplied semantic/execution contract"
  ],
  "closure_status": "open",
  "consumer": "public Merlin StagedProgram kernel and bound-model input, whole-body host execution",
  "definitions": {
    "bytes": 50703,
    "path": "include/triton/Dialect/Triton/IR/TritonOps.td",
    "release": "v3.7.1",
    "repository": "https://github.com/triton-lang/triton",
